{
  "name": "@langchain/langsmith-qoder-plugins",
  "version": "0.1.0",
  "description": "Qoder hooks integration for LangSmith tracing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm bundle",
    "bundle": "node esbuild.config.mjs",
    "dev": "tsc --watch",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsx": "tsx",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "install-hooks": "node scripts/install.mjs",
    "clean": "rm -rf dist bundle"
  },
  "dependencies": {
    "langsmith": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
